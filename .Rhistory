genre <- df |>
group_by(primary_genre) |>
summarise(
total_streams_in_millions = sum(total_streams_in_millions)
) |>
top_n(7, total_streams_in_millions)
genre_graph <- ggplot(genre, aes(x = reorder(primary_genre, -total_streams_in_millions),
y = total_streams_in_millions,
fill = primary_genre)) +
geom_col() +
coord_polar("y", start=0)+
guides(fill = "none") +
scale_y_continuous(labels = scales::label_comma()) +
theme_minimal()
genre_graph
genre_graph <- ggplot(genre, aes(x = reorder(primary_genre, -total_streams_in_millions),
y = total_streams_in_millions,
fill = primary_genre)) +
geom_bar(y = "identity") +
coord_polar("y", start=0)+
guides(fill = "none") +
scale_y_continuous(labels = scales::label_comma()) +
theme_minimal()
