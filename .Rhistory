library(rJava); library(tabulapdf); library(dplyr)
library(tidyr); library(tibble); library(purrr)
library(stringr); library(janitor); library(readr)
tops_library <- '/Users/joshwu/Downloads/TOPS project/tops'
files <- list.files(tops_library,
full.names = TRUE)
years <- c('2016','2017','2018','2019',
'2020','2021','2022','2023',
'2024')
processing <- function(file,year){
out <- extract_tables(file,pages=2, col_names = FALSE) |>
map(as_tibble)
raw <- out[[1]] %>%
slice(-(1))
processed <- raw |>
row_to_names(row_number = 1) |>
clean_names() |>
# keep only the relevant rows
slice(c(1:6), c(12:20)) |>
# add derived columns
mutate(
college_system = ifelse(str_detect(college, "LSU"), "LSU", "UL"),
year           = year
) |>
# drop unwanted columns
select(-starts_with("stipend")) |>
select(-starts_with("natl")) |>
select(-starts_with("total")) |>
select(-matches("_4$|_5$")) |>
# rename by suffix -> prefix
rename_with(~ case_when(
str_detect(.x, "_3$") ~ paste0("honors_",      str_remove(.x, "_3$")),
str_detect(.x, "_2$") ~ paste0("performance_", str_remove(.x, "_2$")),
TRUE                  ~ paste0("opportunity_", .x)
)) |>
# pivot for a united tuition and student count column
pivot_longer(
cols = !c(opportunity_college_system, opportunity_year, opportunity_college),
names_to = c("scholarship_type",".value"),
names_pattern = "^([^_]+)_(.*)$"
) |>
# rename for clean names
rename_with(~ str_remove(.x, "^opportunity_"))
}
df <- map2_dfr(files,years,processing)
tops <- df |>
mutate(tuition = as.integer(parse_number(tuition)),
year = as.integer(parse_number(year)),
student_cnt = as.integer(parse_number(student_cnt)))
tops$scholarship_type <- factor(tops$scholarship_type, levels = c("honors","performance","opportunity"))
#   Visualization --------------------------------------
library(ggplot2); library(patchwork)
award_amount <- ggplot(tops, aes(x = year, y = tuition, color = scholarship_type)) +
stat_summary(fun = sum, geom = "line") +
theme_minimal() +
labs(
color = "Scholarship",
x = "Year",
y = "TOPS Award Amount"
) +
scale_y_continuous(labels = scales::label_dollar())
