#----------------------------------------
# Putting a prior on fit$par (the alpha value)
# Normally, would use MCMC, but there's only 100 observations
# and alpha is one dimensional
#----------------------------------------
flat_pi <- c(.2, .2, .2, .2, .2)
# trying out different combinations of alpha to see what maximizes my log likelihood
log_a <- seq(log(0.01), log(1e4), length.out = 1000)
alpha <- exp(log_a)
# a weakly informative prior,
log_prior <- dnorm(log_a, mean(log_a), 2) |> log()
log_ml <- -sapply(alpha, neg_log_marg_lik, y = Y, pi_0 = flat_pi)
log_post <- log_prior + log_ml
log_post <- log_prior + log_ml
w <- exp(log_post - max(log_post)); w <- w / sum(w)
plot(alpha, w, log = "x", type = "l")
