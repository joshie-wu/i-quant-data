method = "clopper-pearson"))
library(tidyverse); library(dplyr)
library(ggplot2); library(egg)
nyt <- read_csv('/Users/joshwu/Downloads/books - nyt.csv')
goodreads <- read_csv('/Users/joshwu/Downloads/books - goodreads.csv')
nyt_counts <- nyt %>%
count(genre) %>%
mutate(genre = reorder(genre, n))
goodread_counts <- goodreads %>%
count(genre) %>%
mutate(genre = reorder(genre, n))
nyt_genre <- ggplot(nyt_counts, aes(x = genre, y = n)) +
geom_segment(aes(xend = genre, yend = 0), color = "#145214") +
geom_point(fill = "#E8F3E6", color = "#C75C5C", shape = 21, size = 4, alpha = 0.6) +
theme_light() +
coord_flip() +
labs(
y = "# of Times Genre Appears",
x = "Genre"
)+
theme(
panel.grid.major.y = element_blank(),
panel.border = element_blank(),
axis.ticks.y = element_blank()
) +
theme_article()
goodreads_genre <- ggplot(goodread_counts, aes(x = genre, y = n)) +
geom_segment(aes(xend = genre, yend = 0), color = "#145214") +
geom_point(fill = "#E8F3E6", color = "#C75C5C", shape = 21, size = 4, alpha = 0.6) +
theme_light() +
coord_flip() +
labs(
y = "# of Times Genre Appears",
x = "Genre"
) +
theme(
panel.grid.major.y = element_blank(),
panel.border = element_blank(),
axis.ticks.y = element_blank()
) +
theme_article()
merged <- nyt_counts |>
inner_join(goodread_counts, by = "genre", suffix = c("_nyt", "_goodreads"))
ggplot(merged, aes(x = genre)) +
geom_segment( aes(xend = genre, y = n_nyt, yend = n_goodreads), color = "grey") +
geom_point(aes(y = n_nyt), shape = 21, stroke = .25, size = 5,
color = "black", fill = "#D3D3D3") +
geom_text(aes(y = n_nyt), label = "N", size = 2.5, family = "serif") +
geom_point(aes(y = n_goodreads), shape = 21, stroke = .25, size = 5,
color = "#75420e", fill = "#e9e5cd") +
geom_text(aes(y = n_goodreads), label = "g", size = 2.5, family = "Latto") +
coord_flip() +
theme_article()+
theme(
legend.position = "none",
)
nyt_popularity <- ggplot(nyt, aes(total_ratings)) +
geom_density(color = "#000", fill = "#F2F2F2") +
labs(x = "Number of Ratings", y = "Density") +
scale_y_continuous(labels = scales::label_comma()) +
theme_article()
goodreads_popularity <- ggplot(goodreads, aes(total_ratings)) +
geom_density(color = "#75420e", fill = "#e9e5cd") +
labs(x = "Number of Ratings", y = "Density") +
scale_y_continuous(labels = scales::label_comma()) +
theme_article()
stacked <- egg::ggarrange(nyt_popularity, goodreads_popularity, ncol = 1)
combined <- ggplot() +
geom_density(data = nyt, aes(total_ratings),
color = "#000", fill = "#F2F2F2", alpha = 0.6) +
geom_density(data = goodreads, aes(total_ratings),
color = "#75420e", fill = "#e9e5cd", alpha = 0.6) +
labs(x = "Number of Ratings", y = "Density") +
scale_y_continuous(labels = scales::label_comma()) +
theme_article()
ggplot(nyt, aes(log(total_ratings))) +
geom_density(color = "#000", fill = "#F2F2F2") +
labs(x = "(log) Number of Ratings", y = "Density") +
scale_y_continuous(labels = scales::label_comma()) +
theme_article()
ggplot(goodreads, aes(log(total_ratings))) +
geom_density(color = "#75420e", fill = "#e9e5cd") +
labs(x = "(log) Number of Ratings", y = "Density") +
scale_y_continuous(labels = scales::label_comma()) +
theme_article()
ggplot() +
geom_density(data = nyt, aes(log(total_ratings)),
color = "#000", fill = "#F2F2F2", alpha = .5) +
geom_density(data = goodreads, aes(log(total_ratings)),
color = "#75420e", fill = "#e9e5cd", alpha = .5) +
scale_y_continuous(labels = scales::label_comma()) +
theme_article()
View(combined)
View(merged)
View(nyt_popularity)
View(nyt)
wilcox.test(nyt$total_ratings ~ goodreads$total_ratings)
wilcox.test(nyt$total_ratings,goodreads$total_ratings)
ks.test(nyt$total_ratings,goodreads$total_ratings)
ks.test(nyt$total_ratings,goodreads$total_ratings, alternative = "greater")
ks.test(nyt$total_ratings,goodreads$total_ratings, alternative = "less")
ks.test(nyt$total_ratings,goodreads$total_ratings, alternative = "greater")
wilcox.test(log(nyt$total_ratings),log(goodreads$total_ratings))
ks.test(log(nyt$total_ratings),log(goodreads$total_ratings), alternative = "greater")
t.test(log(nyt$total_ratings), log(goodreads$total_ratings))
