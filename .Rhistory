library(tidyverse)
df <- read_csv('/Users/joshwu/Downloads/books - nyt.csv')
# Matrix of observations
y <- df |>
select(title, stars, one_star, two_star, three_star, four_star, five_star)
Y <- as.matrix(y[, c("one_star","two_star","three_star","four_star","five_star")])
storage.mode(Y) <- "double"
View(y)
storage.mode(Y) <- "double"
neg_log_marg_lik <- function(alpha, y, pi_0) {
N <- rowSums(y)
log_lik <- 0
for( i in 1:nrow(y)) {
log_lik <- log_lik + lgamma(alpha) - lgamma(N[i] + alpha)
for (j in 1:ncol(y)) {
log_lik <- log_lik + lgamma(y[i,j] + alpha * pi_0[j]) - lgamma(alpha * pi_0[j])
}
}
return (-log_lik)
}
pi_0 <- c(.025,.05,.2,.3,.425)
fit <- optim(
par = 5,
fn = neg_log_marg_lik,
y = Y,
pi_0 = pi_0,
method = "L-BFGS-B",
lower = 0.001
)
a_prior <- as.vector(fit$par * pi_0)
# Posterior
names(a_prior) <- c("one_star", "two_star", "three_star", "four_star", "five_star")
y_posterior <- y |>
mutate(across(one_star:five_star, ~ .x + a_prior[cur_column()])) |>
mutate(
n_total       = one_star + two_star + three_star + four_star + five_star,
posterior_mean = (1*one_star + 2*two_star + 3*three_star +
4*four_star + 5*five_star) / n_total
)
rank_by_posterior <- y_posterior |>
arrange(desc(posterior_mean)) |>
mutate(goodreads_ranking = row_number())
df <- df |>
left_join(rank_by_posterior %>% select(title, goodreads_ranking), by = "title" ) |>
relocate(goodreads_ranking, .after = nyt_ranking)
View(df)
