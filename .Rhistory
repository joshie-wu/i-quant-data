View(df)
total_streams <- sum(df$total_streams_in_millions)
View(df)
genre_streams <- sum(df %>% filter(primary_genre == "Hip-Hop") %>% select(total_streams_in_millions))
n_squares <- 100
genre_pct <- round(genre_streams / total_streams * n_squares)
waffle_data <- data.frame(
pos = 1:n_squares,
category = c(rep("Genre", genre_pct), rep("Other", n_squares - genre_pct))
) %>%
mutate(
x = (pos - 1) %% 10,
y = (pos - 1) %/% 10
)
ggplot(waffle_data, aes(x = x, y = y, fill = category)) +
geom_tile(color = "white", linewidth = 1.2, width = 0.9, height = 0.9) +
scale_fill_manual(values = c("Genre" = "#E63946", "Other" = "grey80")) +
coord_equal() +
scale_y_reverse() +
theme_void() +
labs(
title = "Genre Streams vs Total Streams",
subtitle = paste0(genre_streams, "M of ", total_streams, "M total streams"),
fill = NULL
) +
theme(
plot.title = element_text(face = "bold", size = 14),
legend.position = "bottom"
)
ggplot(waffle_data, aes(x = x, y = y, fill = category)) +
geom_tile(color = "white", linewidth = 1.2, width = 0.9, height = 0.9) +
scale_fill_manual(values = c("Genre" = "#145214", "Other" = "#F7E8E6")) +
coord_equal() +
scale_y_reverse() +
theme_void() +
labs(
title = "Genre Streams vs Total Streams",
subtitle = paste0(genre_streams, "M of ", total_streams, "M total streams"),
fill = NULL
) +
theme(
plot.title = element_text(face = "bold", size = 14),
legend.position = "bottom"
)
ggplot(waffle_data, aes(x = x, y = y, fill = category)) +
geom_tile(color = "white", linewidth = 1.2, width = 0.9, height = 0.9) +
scale_fill_manual(values = c("Genre" = "#145214", "Other" = "#F7E8E6")) +
