---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.localeCompare(a.data.date));
const toSlug = (post) => post.id.replace(/\.mdx$/, '');

function getFirstParagraph(body) {
  const plainText = body.replace(/^---[\s\S]*?---/, '').trim();
  const firstParagraph = plainText.split(/\n\s*\n/)[0]; // split on blank lines
  return firstParagraph
    .replace(/\[.*?\]\(.*?\)/g, '')   // strip full markdown links [text](url)
    .replace(/&\w+;/g, '')            // strip HTML entities like &emsp;
    .replace(/[#>*`_[\]()]/g, '')     // strip remaining md syntax
    .replace(/\s+/g, ' ')             // collapse extra whitespace left behind
    .trim();
}
---

<section class="blog-list" aria-label="Blog posts">
  {sortedPosts.map((post) => {
    return (
      <a class="blog-card-link" href={`${import.meta.env.BASE_URL}/posts/${toSlug(post)}`}>
        <article class="blog-card">
          <p id="blog-meta">{post.data.date}</p>
          <h1>{post.data.title}</h1>
          <p id="blog-excerpt">{post.data.excerpt}</p>
          <hr class = "new1">
          <p>{getFirstParagraph(post.body)} <a href={`${import.meta.env.BASE_URL}/posts/${toSlug(post)}`}>READ MORE</a></p>
        </article>
      </a>
    );
  })}
</section>