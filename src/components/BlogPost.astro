---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.localeCompare(a.data.date));
const toSlug = (post) => post.id.replace(/\.mdx$/, '');
---

<section class="blog-list" aria-label="Blog posts">
  {sortedPosts.map((post) => {
    return (
      <a className="blog-card-link" href={`${import.meta.env.BASE_URL}/posts/${toSlug(post)}`}>
        <article className="blog-card">
          <p className="blog-meta">{post.data.date}</p>
          <h2>{post.data.title}</h2>
          <p className="blog-excerpt">{post.data.excerpt}</p>
        </article>
      </a>
    );
  })}
</section>