---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.localeCompare(a.data.date));
const toSlug = (post) => post.id.replace(/\.md$/, '');
---

<section class="blog-list" aria-label="Blog posts">
  {sortedPosts.map((post) => (
    <a class="blog-card-link" href={`/posts/${toSlug(post)}`}>
      <article class="blog-card">
        <p class="blog-meta">{post.data.date}</p>
        <h2>{post.data.title}</h2>
        <p class="blog-excerpt">{post.data.excerpt}</p>
      </article>
    </a>
  ))}
</section>
